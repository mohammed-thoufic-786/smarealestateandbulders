# ---------------------------------------------------------------------------
# SMA Real Estate & Builders — Environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. Anything prefixed with NEXT_PUBLIC_ is exposed
# to the browser — never put secrets there.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SMA Real Estate & Builders

# Database -------------------------------------------------------------------
# When MONGODB_URI is empty the app serves the three official SMA properties
# from src/lib/data/properties.ts. Enquiries are persisted to data/enquiries.json.
MONGODB_URI=

# Auth -----------------------------------------------------------------------
# 32+ char random string used to sign session JWTs.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Cloudinary (image / video storage) ----------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp & social links ---------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=9150128777
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1UP65RyDmK/?mibextid=wwXIfr
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/s.m.a_realestate_and_builders?cnvx=MTl2cDgwZnpxcXEyaQ%3D%3D&utm_source=qr
NEXT_PUBLIC_BUSINESS_EMAIL=sma.realestatereal@gmail.com

# Email provider (transactional) --------------------------------------------
# Uses the Resend REST API. RESEND_API_KEY is server-only; never add NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be a sender verified in Resend.
EMAIL_FROM="SMA Real Estate & Builders <sma.realestatereal@gmail.com>"
# Admin copy recipient. Leave blank to use NEXT_PUBLIC_BUSINESS_EMAIL.
ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# OTP provider ---------------------------------------------------------------
OTP_PROVIDER_KEY=
OTP_PROVIDER_SECRET=

# Analytics ------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=

